<Window
  x:Class="PetDesk.App.Views.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:PetDesk.App.Presentation"
  Title="PetDesk"
  Width="512"
  Height="668"
  WindowStyle="None"
  ResizeMode="NoResize"
  AllowsTransparency="True"
  Background="Transparent"
  ShowInTaskbar="False"
  WindowStartupLocation="Manual"
  Style="{StaticResource {x:Type Window}}"
  xmlns:pages="clr-namespace:PetDesk.App.Views.Pages"
  xmlns:vm="clr-namespace:PetDesk.App.ViewModels">
  <Border
    x:Name="Shell"
    Margin="7"
    CornerRadius="23"
    BorderThickness="1.2"
    BorderBrush="{DynamicResource RingBrush}"
    Background="{DynamicResource PanelGradient}"
    Padding="18,16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition
          Height="36" />
        <RowDefinition
          Height="*" />
        <RowDefinition
          Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition
            Width="68" />
          <ColumnDefinition
            Width="8" />
          <ColumnDefinition
            Width="36" />
          <ColumnDefinition
            Width="8" />
          <ColumnDefinition
            Width="36" />
        </Grid.ColumnDefinitions>
        <StackPanel
          Orientation="Horizontal"
          VerticalAlignment="Center">
          <ui:Icon
            Kind="Paw"
            Width="29"
            Height="29"
            Foreground="{DynamicResource AccentBrush}"
            Margin="0,0,10,0" />
          <TextBlock
            Text="PetDesk"
            FontSize="24"
            FontWeight="SemiBold"
            VerticalAlignment="Center" />
        </StackPanel>
        <ComboBox
          Grid.Column="1"
          SelectedIndex="{Binding LanguageIndex}"
          AutomationProperties.Name="{ui:Loc Dashboard.Language}"
          ToolTip="{ui:Loc Dashboard.Language}">
          <ComboBoxItem
            Content="RU" />
          <ComboBoxItem
            Content="EN" />
        </ComboBox>
        <Button
          Grid.Column="3"
          Style="{StaticResource IconButton}"
          Command="{Binding NavigateCommand}"
          CommandParameter="{x:Static vm:DashboardSection.Settings}"
          ToolTip="{ui:Loc Dashboard.Settings}"
          AutomationProperties.Name="{ui:Loc Dashboard.Settings}">
          <ui:Icon
            Kind="Gear"
            Width="19"
            Height="19" />
        </Button>
        <Button
          Grid.Column="5"
          Style="{StaticResource IconButton}"
          Click="More_Click"
          ToolTip="{ui:Loc Dashboard.More}"
          AutomationProperties.Name="{ui:Loc Dashboard.More}">
          <ui:Icon
            Kind="Dots"
            Width="20"
            Height="20" />
          <Button.ContextMenu>
            <ContextMenu
              DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem
                Header="{ui:Loc Menu.AppFolder}"
                Command="{Binding OpenFolderCommand}"
                CommandParameter="app" />
              <MenuItem
                Header="{ui:Loc Menu.About}"
                Command="{Binding NavigateCommand}"
                CommandParameter="{x:Static vm:DashboardSection.About}" />
              <Separator />
              <MenuItem
                Header="{ui:Loc Menu.Exit}"
                Command="{Binding ExitCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>
      <Grid
        Grid.Row="1"
        Margin="0,12,0,0">
        <Grid.RowDefinitions>
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="*" />
        </Grid.RowDefinitions>
        <DockPanel
          Visibility="{Binding IsSubpage, Converter={StaticResource BoolVisibility}}"
          Margin="0,0,0,14">
          <Button
            Style="{StaticResource IconButton}"
            Command="{Binding NavigateCommand}"
            CommandParameter="{x:Static vm:DashboardSection.Dashboard}"
            ToolTip="{ui:Loc Nav.Back}"
            AutomationProperties.Name="{ui:Loc Nav.Back}">
            <ui:Icon
              Kind="Back"
              Width="19"
              Height="19" />
          </Button>
          <TextBlock
            Text="{Binding PageTitle}"
            FontSize="18"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            Margin="12,0,0,0" />
        </DockPanel>
        <ScrollViewer
          Grid.Row="1"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled"
          x:Name="Scroller"
          Padding="1,0,3,0">
          <Grid>
            <pages:DashboardView
              Visibility="{Binding IsDashboard, Converter={StaticResource BoolVisibility}}" />
            <pages:SettingsView
              Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" />
            <pages:PaletteEditorView
              Visibility="{Binding IsEditor, Converter={StaticResource BoolVisibility}}"
              x:Name="PaletteEditor" />
            <pages:AboutView
              Visibility="{Binding IsAbout, Converter={StaticResource BoolVisibility}}" />
          </Grid>
        </ScrollViewer>
      </Grid>
      <TextBlock
        Grid.Row="2"
        Text="{Binding Status}"
        TextWrapping="Wrap"
        FontSize="10.5"
        Margin="2,12,2,0"
        AutomationProperties.Name="{Binding Status}">
        <TextBlock.Style>
          <Style
            TargetType="TextBlock">
            <Setter
              Property="Foreground"
              Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding StatusIsError}"
                Value="True">
                <Setter
                  Property="Foreground"
                  Value="{DynamicResource ErrorBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Border>
</Window>
