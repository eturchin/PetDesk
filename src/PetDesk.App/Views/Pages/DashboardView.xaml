<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:PetDesk.App.Presentation"
  x:Class="PetDesk.App.Views.Pages.DashboardView">
  <UserControl.Resources>
    <DataTemplate
      x:Key="PetTemplate">
      <Grid
        MinHeight="30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="38" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Image
          Source="{Binding Thumbnail}"
          Width="30"
          Height="30"
          Stretch="Uniform" />
        <ui:Icon
          Kind="Plus"
          Width="20"
          Height="20"
          Foreground="{DynamicResource AccentBrush}"
          Visibility="{Binding IsAdd, Converter={StaticResource BoolVisibility}}" />
        <TextBlock
          Grid.Column="1"
          Text="{Binding Name}"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>
    <Style
      x:Key="MetricLabel"
      TargetType="TextBlock">
      <Setter
        Property="FontSize"
        Value="11.5" />
      <Setter
        Property="VerticalAlignment"
        Value="Center" />
      <Setter
        Property="TextWrapping"
        Value="Wrap" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Grid
      Width="156"
      Height="156"
      Margin="0,2,0,0">
      <Ellipse
        Fill="{DynamicResource PreviewBrush}"
        Stroke="{DynamicResource LineBrush}"
        StrokeThickness="2" />
      <Ellipse
        Stroke="{DynamicResource RingBrush}"
        StrokeThickness="3">
        <Ellipse.Effect>
          <DropShadowEffect
            Color="{DynamicResource GlowColor}"
            BlurRadius="12"
            ShadowDepth="0"
            Opacity="0.32" />
        </Ellipse.Effect>
      </Ellipse>
      <Image
        Source="{Binding Preview}"
        Width="128"
        Height="128"
        Stretch="Uniform"
        AutomationProperties.Name="{ui:Loc Palette.Preview}" />
    </Grid>
    <TextBlock
      Text="{Binding PetName}"
      FontSize="25"
      FontWeight="SemiBold"
      HorizontalAlignment="Center"
      MaxWidth="410"
      TextTrimming="CharacterEllipsis"
      Margin="0,10,0,5"
      ToolTip="{Binding PetName}" />
    <StackPanel
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Margin="0,0,0,15">
      <Ellipse
        Width="8"
        Height="8"
        Margin="0,0,7,0">
        <Ellipse.Style>
          <Style
            TargetType="Ellipse">
            <Setter
              Property="Fill"
              Value="{DynamicResource ActiveBrush}" />
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding PetVisible}"
                Value="False">
                <Setter
                  Property="Fill"
                  Value="{DynamicResource MutedBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
      <TextBlock
        Text="{Binding PetStatus}"
        Style="{StaticResource Muted}" />
    </StackPanel>
    <ComboBox
      ItemsSource="{Binding Pets}"
      SelectedItem="{Binding SelectedPet}"
      ItemTemplate="{StaticResource PetTemplate}"
      FontSize="15"
      MinHeight="45"
      Margin="0,0,0,17"
      AutomationProperties.Name="{ui:Loc Library.Choose}" />
    <Grid
      Height="112">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="148" />
        <ColumnDefinition
          Width="11" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border
        Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <StackPanel
            Orientation="Horizontal">
            <ui:Icon
              Kind="Eye"
              Width="21"
              Height="21"
              Margin="0,0,7,0" />
            <TextBlock
              Text="{ui:Loc Dashboard.Pet}"
              FontSize="15"
              FontWeight="SemiBold"
              VerticalAlignment="Center" />
          </StackPanel>
          <Grid
            Grid.Row="1"
            Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition
                Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="{ui:Loc Dashboard.Show}"
              Style="{StaticResource CardMuted}"
              FontSize="11"
              VerticalAlignment="Center"
              Margin="0,0,5,0" />
            <CheckBox
              Grid.Column="1"
              Style="{StaticResource Switch}"
              IsChecked="{Binding PetVisible}"
              VerticalAlignment="Center"
              AutomationProperties.Name="{ui:Loc Dashboard.Show}" />
          </Grid>
        </Grid>
      </Border>
      <Border
        Grid.Column="2"
        Style="{StaticResource Card}"
        Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <StackPanel
            Orientation="Horizontal"
            Margin="0,0,0,8">
            <ui:Icon
              Kind="Move"
              Width="18"
              Height="18"
              Margin="0,0,7,0" />
            <TextBlock
              Text="{ui:Loc Dashboard.Movement}"
              FontSize="13"
              FontWeight="SemiBold" />
          </StackPanel>
          <UniformGrid
            Grid.Row="1"
            Columns="3">
            <ToggleButton
              Style="{StaticResource ModeTile}"
              IsChecked="{Binding IsFree, Mode=OneWay}"
              Command="{Binding SetMovementCommand}"
              CommandParameter="Free"
              AutomationProperties.Name="{ui:Loc Mode.Free}">
              <StackPanel>
                <ui:Icon
                  Kind="Free"
                  Width="22"
                  Height="22"
                  Margin="0,0,0,5" />
                <TextBlock
                  Text="{ui:Loc Mode.Free}"
                  FontSize="10.2"
                  TextAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton
              Style="{StaticResource ModeTile}"
              IsChecked="{Binding IsFixed, Mode=OneWay}"
              Command="{Binding SetMovementCommand}"
              CommandParameter="Fixed"
              AutomationProperties.Name="{ui:Loc Mode.FixedFull}">
              <StackPanel>
                <ui:Icon
                  Kind="Pin"
                  Width="22"
                  Height="22"
                  Margin="0,0,0,5" />
                <TextBlock
                  Text="{ui:Loc Mode.Fixed}"
                  FontSize="10.2"
                  TextAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton
              Style="{StaticResource ModeTile}"
              IsChecked="{Binding IsTaskbar, Mode=OneWay}"
              Command="{Binding SetMovementCommand}"
              CommandParameter="Taskbar"
              AutomationProperties.Name="{ui:Loc Mode.Taskbar}">
              <StackPanel>
                <ui:Icon
                  Kind="Monitor"
                  Width="22"
                  Height="22"
                  Margin="0,0,0,5" />
                <TextBlock
                  Text="{ui:Loc Mode.Taskbar}"
                  FontSize="10.2"
                  TextAlignment="Center" />
              </StackPanel>
            </ToggleButton>
          </UniformGrid>
        </Grid>
      </Border>
    </Grid>
    <Grid
      Margin="0,11,0,0"
      Height="116">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition
          Width="10" />
        <ColumnDefinition />
        <ColumnDefinition
          Width="10" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border
        Style="{StaticResource Card}"
        Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition
              Height="27" />
            <RowDefinition />
            <RowDefinition
              Height="25" />
          </Grid.RowDefinitions>
          <StackPanel
            Orientation="Horizontal">
            <ui:Icon
              Kind="Expand"
              Width="17"
              Height="17"
              Margin="0,0,6,0" />
            <TextBlock
              Text="{ui:Loc Metric.Size}"
              Style="{StaticResource MetricLabel}" />
          </StackPanel>
          <TextBlock
            Grid.Row="1"
            Text="{Binding ScalePercent, StringFormat={}{0:0} %}"
            FontSize="25"
            VerticalAlignment="Center" />
          <Slider
            Grid.Row="2"
            Minimum="50"
            Maximum="200"
            Value="{Binding ScalePercent}"
            AutomationProperties.Name="{ui:Loc Metric.Size}" />
        </Grid>
      </Border>
      <Border
        Grid.Column="2"
        Style="{StaticResource Card}"
        Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition
              Height="27" />
            <RowDefinition />
            <RowDefinition
              Height="25" />
          </Grid.RowDefinitions>
          <StackPanel
            Orientation="Horizontal">
            <ui:Icon
              Kind="Drop"
              Width="17"
              Height="17"
              Margin="0,0,6,0" />
            <TextBlock
              Text="{ui:Loc Metric.Opacity}"
              Style="{StaticResource MetricLabel}"
              FontSize="10.7" />
          </StackPanel>
          <TextBlock
            Grid.Row="1"
            Text="{Binding OpacityPercent, StringFormat={}{0:0} %}"
            FontSize="25"
            VerticalAlignment="Center" />
          <Slider
            Grid.Row="2"
            Minimum="30"
            Maximum="100"
            Value="{Binding OpacityPercent}"
            AutomationProperties.Name="{ui:Loc Metric.Opacity}" />
        </Grid>
      </Border>
      <Border
        Grid.Column="4"
        Style="{StaticResource Card}"
        Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition
              Height="27" />
            <RowDefinition />
            <RowDefinition
              Height="25" />
          </Grid.RowDefinitions>
          <StackPanel
            Orientation="Horizontal">
            <ui:Icon
              Kind="Gauge"
              Width="17"
              Height="17"
              Margin="0,0,6,0" />
            <TextBlock
              Text="{ui:Loc Metric.Speed}"
              Style="{StaticResource MetricLabel}" />
          </StackPanel>
          <TextBlock
            Grid.Row="1"
            Text="{Binding SpeedPercent, StringFormat={}{0:0} %}"
            FontSize="25"
            VerticalAlignment="Center" />
          <Slider
            Grid.Row="2"
            Minimum="13.3333333333333"
            Maximum="333.333333333333"
            Value="{Binding SpeedPercent}"
            AutomationProperties.Name="{ui:Loc Metric.Speed}" />
        </Grid>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
