<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:PetDesk.App.Presentation"
  x:Class="PetDesk.App.Views.Pages.PaletteEditorView">
  <UserControl.Resources>
    <Style
      x:Key="FieldLabel"
      TargetType="TextBlock">
      <Setter
        Property="VerticalAlignment"
        Value="Center" />
      <Setter
        Property="FontSize"
        Value="12" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Border
      Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock
          Text="{ui:Loc Palette.Name}" />
        <TextBox
          Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
          MaxLength="40"
          Margin="0,6,0,14"
          AutomationProperties.Name="{ui:Loc Palette.Name}" />
        <Grid
          Margin="0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
              Width="29" />
            <ColumnDefinition
              Width="112" />
            <ColumnDefinition
              Width="7" />
            <ColumnDefinition
              Width="34" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Text="{ui:Loc Palette.Background}"
            Style="{StaticResource FieldLabel}" />
          <Border
            Grid.Column="1"
            Background="{Binding Editor.Background}"
            CornerRadius="5"
            Width="22"
            Height="25" />
          <TextBox
            Grid.Column="2"
            Text="{Binding Editor.Background, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
            MaxLength="7"
            CharacterCasing="Upper"
            AutomationProperties.Name="{ui:Loc Palette.Background}" />
          <Button
            Grid.Column="4"
            Style="{StaticResource IconButton}"
            Width="34"
            Command="{Binding PickColorCommand}"
            CommandParameter="Background"
            ToolTip="{ui:Loc Palette.Pick}">
            <ui:Icon
              Kind="Palette"
              Width="17"
              Height="17" />
          </Button>
        </Grid>
        <Grid
          Margin="0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
              Width="29" />
            <ColumnDefinition
              Width="112" />
            <ColumnDefinition
              Width="7" />
            <ColumnDefinition
              Width="34" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Text="{ui:Loc Palette.Surface}"
            Style="{StaticResource FieldLabel}" />
          <Border
            Grid.Column="1"
            Background="{Binding Editor.Surface}"
            CornerRadius="5"
            Width="22"
            Height="25" />
          <TextBox
            Grid.Column="2"
            Text="{Binding Editor.Surface, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
            MaxLength="7"
            CharacterCasing="Upper"
            AutomationProperties.Name="{ui:Loc Palette.Surface}" />
          <Button
            Grid.Column="4"
            Style="{StaticResource IconButton}"
            Width="34"
            Command="{Binding PickColorCommand}"
            CommandParameter="Surface"
            ToolTip="{ui:Loc Palette.Pick}">
            <ui:Icon
              Kind="Palette"
              Width="17"
              Height="17" />
          </Button>
        </Grid>
        <Grid
          Margin="0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
              Width="29" />
            <ColumnDefinition
              Width="112" />
            <ColumnDefinition
              Width="7" />
            <ColumnDefinition
              Width="34" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Text="{ui:Loc Palette.Primary}"
            Style="{StaticResource FieldLabel}" />
          <Border
            Grid.Column="1"
            Background="{Binding Editor.Primary}"
            CornerRadius="5"
            Width="22"
            Height="25" />
          <TextBox
            Grid.Column="2"
            Text="{Binding Editor.Primary, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
            MaxLength="7"
            CharacterCasing="Upper"
            AutomationProperties.Name="{ui:Loc Palette.Primary}" />
          <Button
            Grid.Column="4"
            Style="{StaticResource IconButton}"
            Width="34"
            Command="{Binding PickColorCommand}"
            CommandParameter="Primary"
            ToolTip="{ui:Loc Palette.Pick}">
            <ui:Icon
              Kind="Palette"
              Width="17"
              Height="17" />
          </Button>
        </Grid>
        <Grid
          Margin="0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
              Width="29" />
            <ColumnDefinition
              Width="112" />
            <ColumnDefinition
              Width="7" />
            <ColumnDefinition
              Width="34" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Text="{ui:Loc Palette.Accent}"
            Style="{StaticResource FieldLabel}" />
          <Border
            Grid.Column="1"
            Background="{Binding Editor.Accent}"
            CornerRadius="5"
            Width="22"
            Height="25" />
          <TextBox
            Grid.Column="2"
            Text="{Binding Editor.Accent, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
            MaxLength="7"
            CharacterCasing="Upper"
            AutomationProperties.Name="{ui:Loc Palette.Accent}" />
          <Button
            Grid.Column="4"
            Style="{StaticResource IconButton}"
            Width="34"
            Command="{Binding PickColorCommand}"
            CommandParameter="Accent"
            ToolTip="{ui:Loc Palette.Pick}">
            <ui:Icon
              Kind="Palette"
              Width="17"
              Height="17" />
          </Button>
        </Grid>
        <Grid
          Margin="0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
              Width="29" />
            <ColumnDefinition
              Width="112" />
            <ColumnDefinition
              Width="7" />
            <ColumnDefinition
              Width="34" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Text="{ui:Loc Palette.Glow}"
            Style="{StaticResource FieldLabel}" />
          <Border
            Grid.Column="1"
            Background="{Binding Editor.Glow}"
            CornerRadius="5"
            Width="22"
            Height="25" />
          <TextBox
            Grid.Column="2"
            Text="{Binding Editor.Glow, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
            MaxLength="7"
            CharacterCasing="Upper"
            AutomationProperties.Name="{ui:Loc Palette.Glow}" />
          <Button
            Grid.Column="4"
            Style="{StaticResource IconButton}"
            Width="34"
            Command="{Binding PickColorCommand}"
            CommandParameter="Glow"
            ToolTip="{ui:Loc Palette.Pick}">
            <ui:Icon
              Kind="Palette"
              Width="17"
              Height="17" />
          </Button>
        </Grid>
        <TextBlock
          Text="{ui:Loc Palette.HexHint}"
          Style="{StaticResource CardMuted}"
          Margin="0,12,0,0" />
      </StackPanel>
    </Border>
    <Border
      x:Name="PalettePreview"
      Margin="0,12"
      Background="{DynamicResource PageBrush}"
      BorderBrush="{DynamicResource LineBrush}"
      BorderThickness="1"
      CornerRadius="15"
      Padding="15">
      <StackPanel>
        <TextBlock
          Text="{ui:Loc Palette.Preview}"
          Foreground="{DynamicResource TextBrush}"
          Margin="0,0,0,10" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="65" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Image
            Source="{Binding Preview}"
            Height="62"
            Width="62" />
          <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center">
            <TextBlock
              Text="{Binding PetName}"
              Foreground="{DynamicResource TextBrush}"
              FontSize="18"
              FontWeight="SemiBold" />
            <TextBlock
              Text="{Binding PetStatus}"
              Foreground="{DynamicResource MutedBrush}"
              FontSize="11" />
          </StackPanel>
        </Grid>
        <Border
          Style="{StaticResource Card}"
          Margin="0,10,0,0">
          <DockPanel>
            <TextBlock
              Text="{ui:Loc Metric.Size}"
              VerticalAlignment="Center" />
            <Border
              Background="{DynamicResource AccentBrush}"
              CornerRadius="8"
              HorizontalAlignment="Right"
              Padding="15,6">
              <TextBlock
                Text="100 %"
                Foreground="{DynamicResource AccentTextBrush}" />
            </Border>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>
    <Button
      Content="{ui:Loc Palette.Save}"
      Command="{Binding SavePaletteCommand}"
      Style="{StaticResource PrimaryButton}" />
  </StackPanel>
</UserControl>
